# Copy to .env and replace every placeholder. Never commit .env.
TMV1_API_KEY=replace-with-your-vision-one-litellm-token
TRENDAI_AI_GUARD_BASE_URL=https://api.xdr.trendmicro.com/v3.0/aiSecurity

# Use independent, randomly generated values.
LITELLM_MASTER_KEY=replace-with-a-long-random-proxy-key
WEBUI_SECRET_KEY=replace-with-a-long-random-webui-secret

OLLAMA_MODEL=llama3.2
OPEN_WEBUI_PORT=3000
LITELLM_PORT=4000

# Local denied-topic policy profile and pinned zero-shot classifier.
TOPIC_POLICY_PROFILE=openwebui
TOPIC_MODEL_ID=MoritzLaurer/ModernBERT-base-zeroshot-v2.0
TOPIC_MODEL_REVISION=d421c4545a438fd006fb43f8b981c5d908faa1e1

# Override only after validating compatibility.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
OLLAMA_IMAGE=ollama/ollama:latest
