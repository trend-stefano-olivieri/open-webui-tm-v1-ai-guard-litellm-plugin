ARG OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
FROM ${OPEN_WEBUI_IMAGE}

COPY patches/apply_openwebui_builtin_tools_gate.py /tmp/apply_openwebui_builtin_tools_gate.py
COPY patches/apply_openwebui_guardrail_denials.py /tmp/apply_openwebui_guardrail_denials.py
RUN python /tmp/apply_openwebui_builtin_tools_gate.py \
      /app/backend/open_webui/utils/middleware.py \
    && python /tmp/apply_openwebui_guardrail_denials.py \
      /app/backend/open_webui/main.py \
    && rm \
      /tmp/apply_openwebui_builtin_tools_gate.py \
      /tmp/apply_openwebui_guardrail_denials.py
